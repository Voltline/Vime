            tensor<fp32, [?, 1]> var_1975 = add(x = variance, y = var_1974)[name = string("op_1975")];
            fp32 var_1976_epsilon_0 = const()[name = string("op_1976_epsilon_0"), val = fp32(0x1.197998p-40)];
            tensor<fp32, [?, 1]> var_1976 = rsqrt(epsilon = var_1976_epsilon_0, x = var_1975)[name = string("op_1976")];
            tensor<fp32, [?, 384]> normalized_73 = mul(x = hidden_75, y = var_1976)[name = string("normalized_73")];
            tensor<fp32, [?, 384]> input = mul(x = normalized_73, y = model_final_norm_weight)[name = string("input")];
            tensor<fp32, [12288]> linear_45_bias_0 = const()[name = string("linear_45_bias_0"), val = tensor<fp32, [12288]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(22579776)))];
            tensor<fp32, [?, 12288]> logits = linear(bias = linear_45_bias_0, weight = model_token_embedding_weight_quantized, x = input)[name = string("linear_45")];
            tensor<int32, [1]> var_1985_axes_0 = const()[name = string("op_1985_axes_0"), val = tensor<int32, [1]>([-1])];
            bool var_1985_keep_dims_0 = const()[name = string("op_1985_keep_dims_0"), val = bool(false)];
            tensor<fp32, [?]> logsumexp = reduce_log_sum_exp(axes = var_1985_axes_0, keep_dims = var_1985_keep_dims_0, x = logits)[name = string("op_1985")];
            int32 var_1987_batch_dims_0 = const()[name = string("op_1987_batch_dims_0"), val = int32(0)];
            bool var_1987_validate_indices_0 = const()[name = string("op_1987_validate_indices_0"), val = bool(false)];
            int32 greater_equal_6_y_0 = const()[name = string("greater_equal_6_y_0"), val = int32(0)];
            tensor<bool, [?]> greater_equal_6 = greater_equal(x = allowed, y = greater_equal_6_y_0)[name = string("greater_equal_6")];
            int32 slice_by_index_6 = const()[name = string("slice_by_index_6"), val = int32(12288)];
            tensor<int32, [?]> add_6 = add(x = allowed, y = slice_by_index_6)[name = string("add_6")];
            tensor<int32, [?]> select_6 = select(a = allowed, b = add_6, cond = greater_equal_6)[name = string("select_6")];
            int32 greater_equal_6_y_0_1 = const()[name = string("greater_equal_6_y_0_1"), val = int32(0)];
            tensor<bool, [?]> greater_equal_6_1 = greater_equal(x = select_6, y = greater_equal_6_y_0_1)[name = string("greater_equal_6_1")];
            int32 slice_by_index_6_1 = const()[name = string("slice_by_index_6_1"), val = int32(12288)];
            tensor<int32, [?]> add_6_1 = add(x = select_6, y = slice_by_index_6_1)[name = string("add_6_1")];
            tensor<int32, [?]> select_6_1 = select(a = select_6, b = add_6_1, cond = greater_equal_6_1)[name = string("select_6_1")];
            int32 op_1987_axis_0 = const()[name = string("op_1987_axis_0"), val = int32(1)];
            tensor<fp32, [?, ?]> allowed_logits = gather(axis = op_1987_axis_0, batch_dims = var_1987_batch_dims_0, indices = select_6_1, validate_indices = var_1987_validate_indices_0, x = logits)[name = string("op_1987")];
        } -> (logsumexp, allowed_logits, new_key, new_value);
}
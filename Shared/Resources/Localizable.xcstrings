        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選以採用建議讀音"
          }
        }
      }
    },
    "点右上角 +，记下姓名、专业词或常用短语。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add names, terms or phrases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の + をタップして、名前や専門用語、よく使う定型文を登録します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 +，記下姓名、專業詞或常用短語。"
          }
        }
      }
    },
    "点选即可使用，重新打开键盘后生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to use; it applies after reopening the keyboard."
          }

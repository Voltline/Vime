    "1. 打开 iPhone 的“设置”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Settings on your iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. iPhone の「設定」を開きます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 打開 iPhone 的「設定」。"
          }
        }
      }
    },
    "2. 进入“通用 → 键盘 → 键盘”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Go to General → Keyboard → Keyboards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 「一般 → キーボード → キーボード」に進みます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 進入「一般 → 鍵盤 → 鍵盤」。"
          }
        }
      }
    },
    "3. 点击“添加新键盘”，选择 Vime。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Tap Add New Keyboard and choose Vime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 「新しいキーボードを追加」をタップし、Vime を選びます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 點選「新增鍵盤」，選擇 Vime。"
          }
        }
      }
    },
    "App 与键盘在本机共享设置、皮肤、用户词典和学习文件。系统备份可能包含这些数据，恢复备份时也可能恢复。剪贴板历史仅保留最近 24 小时，并排除在备份之外。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and keyboard share settings, skins, the user dictionary and learning files on this device. System backups may include this data and restore it. Clipboard history keeps only the last 24 hours and is excluded from backups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App とキーボードは、設定・スキン・ユーザ辞書・学習ファイルを端末内で共有します。これらはシステムのバックアップに含まれ、復元時に戻る場合があります。クリップボード履歴は直近 24 時間分のみ保持し、バックアップから除外されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 與鍵盤在本機共用設定、主題、使用者辭典和學習檔案。系統備份可能包含這些資料，回復備份時也可能一併回復。剪貼簿歷史記錄僅保留最近 24 小時，並排除在備份之外。"
          }
        }
      }
    },
    "App 设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App の設定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 設定"
          }
        }
      }
    },
    "CorrectionReadings.bin 是固定默认词典的衍生索引，包含读音哈希、词条成本与连接 ID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin is an index derived from the fixed default dictionary, holding reading hashes, word costs and connection IDs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin は固定の標準辞書から派生したインデックスで、読みのハッシュ・単語コスト・接続 ID を含みます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin 是固定預設辭典的衍生索引，包含讀音雜湊、詞條成本與連接 ID"
          }
        }
      }
    },
    "Shift": {
      "shouldTranslate": false
    },
    "Swift 实现，增加长度、版本和维度校验，支持有界缓存": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift implementation with length, version and dimension checks and a bounded cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift による実装。長さ・バージョン・サイズの検証と上限付きキャッシュを追加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 實作，增加長度、版本和維度驗證，支援有界快取"
          }
        }
      }
    },
    "Vime %@": {
      "shouldTranslate": false
    },
    "Vime 日语模型 V%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime Japanese model V%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime 日本語モデル V%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime 日語模型 V%@"
          }
        }
      }
    },
    "Vime 筛选词语与口语条目、提取假名表记偏好；衍生语言数据与 App 代码分别展示许可": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime filters words and colloquial entries and extracts kana spelling preferences; derived language data and app code show their licenses separately"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime は単語と口語の項目を選び、かな表記の好みを抽出しています。派生した言語データと App のコードは別々にライセンスを表示します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vime 篩選詞語與口語詞條、擷取假名表記偏好；衍生語言資料與 App 程式碼分別顯示授權"
          }
        }
      }
    },
    "Vime 隐私政策": {
      "localizations": {

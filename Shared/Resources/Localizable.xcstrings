    "Core ML INT8 量化编译版本；附 App Store 分发额外许可": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiled Core ML INT8 build, with an additional permission for App Store distribution"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core ML INT8 量子化コンパイル版。App Store 配布のための追加許可付き"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Core ML INT8 양자화 컴파일 버전, App Store 배포를 위한 추가 허가 포함"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Core ML INT8 量化編譯版本；附 App Store 發佈額外許可"
          }
        }
      }
    },
    "CorrectionReadings.bin 是固定默认词典的衍生索引，包含读音哈希、词条成本与连接 ID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin is an index derived from the fixed default dictionary, holding reading hashes, word costs and connection IDs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin は固定の標準辞書から派生したインデックスで、読みのハッシュ・単語コスト・接続 ID を含みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin은 고정된 기본 사전에서 생성한 인덱스로, 읽기 해시, 단어 비용 및 연결 ID를 담고 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CorrectionReadings.bin 是固定預設辭典的衍生索引，包含讀音雜湊、詞條成本與連接 ID"
          }
        }
      }
    },
    "Shift": {
      "shouldTranslate": false
    },
    "Swift 实现，增加长度、版本和维度校验，支持有界缓存": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift implementation with length, version and dimension checks and a bounded cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift による実装。長さ・バージョン・サイズの検証と上限付きキャッシュを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이, 버전 및 차원 검사와 크기가 제한된 캐시를 갖춘 Swift 구현"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 實作，增加長度、版本和維度驗證，支援有界快取"
          }
        }
      }
    },

    "剪贴板": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿"
          }
        }
      }
    },
    "剪贴板历史": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard History"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿歷史記錄"
          }
        }
      }
    },
    "剪贴板可能包含密码、验证码或其他敏感信息，请按需开启。历史保存在本机数据库，不上传、不纳入 Vime 的系统备份，也不因检测或粘贴操作直接写入学习词典。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard may contain passwords, codes or other sensitive data, so turn this on only if you need it. History is stored in an on-device database, never uploaded, excluded from Vime's system backups, and never written to the learning dictionary by detection or pasting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにはパスワードや認証コードなどの機密情報が含まれることがあります。必要な場合にのみオンにしてください。履歴は端末内のデータベースに保存され、送信されず、Vime のシステムバックアップにも含まれません。検出や貼り付けで学習辞書に書き込まれることもありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿可能包含密碼、驗證碼或其他敏感資訊，請依需要開啟。歷史記錄儲存在本機資料庫，不會上傳、不納入 Vime 的系統備份，也不會因偵測或貼上操作直接寫入學習辭典。"
          }
        }
      }
    },

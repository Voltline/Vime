    "智能排序": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Ranking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート並べ替え"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧排序"
          }
        }
      }
    },
    "智能排序使用本地模型调整候选顺序\n下一词联想在确认文字后提供建议\n关闭智能排序或联想不会清除已有学习数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart ranking uses an on-device model to order candidates\nNext-word suggestions appear after you confirm text\nTurning either off keeps existing learning data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート並べ替えは端末内モデルで候補の順序を調整します\n次の語の予測は確定後に候補を表示します\nどちらをオフにしても学習データは消えません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧排序使用本機模型調整候選順序\n下一詞聯想在確認文字後提供建議\n關閉智慧排序或聯想不會清除已有學習資料"
          }
        }
      }
    },
    "暂无剪贴板历史\n开启功能后，近期复制的文字会保留在这里": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clipboard history\nAfter you turn this on, recently copied text appears here"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴はありません\n機能をオンにすると、最近コピーしたテキストがここに残ります"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無剪貼簿歷史記錄\n開啟功能後，近期拷貝的文字會保留在這裡"
          }
        }
      }
    },

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환, 교정, 순위 결정 및 제안은 기기에서 실행되며, 입력 내용과 클립보드 내용은 업로드되지 않습니다."
          }
        },
        "zh-Hant": {

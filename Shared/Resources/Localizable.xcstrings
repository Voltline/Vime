    "上下拖动调整键盘高度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down to adjust keyboard height"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグしてキーボードの高さを調整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖移以調整鍵盤高度"
          }
        }
      }
    },
    "上下标": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Super/Subscript"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上付き・下付き"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下標"
          }
        }
      }
    },
    "上下滑动左侧栏使用这些符号。可以删除或拖动排序，最多保留 32 项，每项最多 4 个字符。修改后重新打开键盘即可生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe the left rail up or down to use these symbols. You can delete or reorder them; up to 32 items, 4 characters each. Changes apply after reopening the keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左側のバーを上下にスワイプしてこれらの記号を使います。削除や並べ替えができ、最大 32 項目、各 4 文字までです。変更はキーボードを開き直すと反映されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下滑動左側欄使用這些符號。可以刪除或拖移排序，最多保留 32 項，每項最多 4 個字元。修改後重新打開鍵盤即可生效。"
          }
        }
      }
    },
    "上下滑动选择符号，底部的编辑入口可打开 Vime 设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to pick a symbol. The edit button at the bottom opens Vime settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプして記号を選択。下部の編集ボタンから Vime の設定を開けます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下滑動選擇符號，底部的編輯入口可打開 Vime 設定"
          }
        }
      }
    },
    "上次清空已完成。键盘会重新学习输入习惯；用户词典、剪贴板历史和皮肤保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last reset is complete. The keyboard will relearn your habits; the user dictionary, clipboard history and skins are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の消去は完了しました。キーボードは入力の傾向を学び直します。ユーザ辞書・クリップボード履歴・スキンは残ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次清除已完成。鍵盤會重新學習輸入習慣；使用者辭典、剪貼簿歷史記錄和主題會保留。"
          }
        }
      }
    },
    "上滑清空": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up to clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上スワイプで消去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑清除"
          }
        }
      }
    },

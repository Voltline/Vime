    "图片无效或过大，仅支持 PNG/JPEG，总像素不超过 500 万": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is invalid or too large. Only PNG/JPEG up to 5 megapixels are supported."
          }
        },
        "ja": {
          "stringUnit": {

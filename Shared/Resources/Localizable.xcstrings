    "在 iOS“设置 → 通用 → 键盘 → 键盘 → Vime”中开启“允许完全访问”，并允许系统的粘贴请求。这是两项不同的授权。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS Settings → General → Keyboard → Keyboards → Vime, turn on Allow Full Access, and allow the system paste request. These are two separate permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の「設定 → 一般 → キーボード → キーボード → Vime」で「フルアクセスを許可」をオンにし、システムの貼り付け要求も許可してください。この 2 つは別々の許可です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS「設定 → 一般 → 鍵盤 → 鍵盤 → Vime」中開啟「允許完整取用」，並允許系統的貼上請求。這是兩項不同的授權。"
          }
        }
      }
    },
    "在任意输入框切换到 Vime 打一个字": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Vime in any text field and type"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の入力欄で Vime に切り替えて 1 文字入力"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一輸入框切換到 Vime 打一個字"
          }
        }
      }
    },
    "在键盘左上角菜单中打开“剪贴板历史”，点击记录即可输入，也可以清空历史。键盘隐藏时收起临时提示，历史仍保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Clipboard History from the menu at the keyboard's top left; tap an entry to type it, or clear the history. Temporary prompts close when the keyboard hides; history is kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード左上のメニューから「クリップボード履歴」を開き、項目をタップすると入力できます。履歴の消去もできます。キーボードを閉じると一時的な表示は消えますが、履歴は残ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤左上角選單中打開「剪貼簿歷史記錄」，點選記錄即可輸入，也可以清除歷史記錄。鍵盤隱藏時會收起暫時提示，歷史記錄仍保留。"
          }
        }
      }
    },
    "声音、振动、共享词典与学习需要完全访问": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds, haptics and shared dictionary and learning need Full Access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンド・振動・辞書と学習の共有にはフルアクセスが必要です"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音、震動、共用辭典與學習需要完整取用"
          }
        }
      }
    },
    "声音、振动和数字布局也可在键盘左上角快速调整\n修改后重新打开键盘即可读取更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds, haptics and number layout can also be changed from the keyboard's top-left menu\nChanges apply after reopening the keyboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンド・振動・数字配列はキーボード左上からもすぐ変更できます\n変更はキーボードを開き直すと反映されます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音、震動和數字佈局也可在鍵盤左上角快速調整\n修改後重新打開鍵盤即可讀取更新"
          }
        }
      }
    },
    "声音与振动": {
      "localizations": {
        "en": {
